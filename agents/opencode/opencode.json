  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo rm *": "deny",
      "sudo *": "deny",
      "diskutil *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "halt": "deny"
    }
  },
  "agent": {
    "review": {
      "description": "Reviews PRs and docs changes critically. Focuses on real bugs, logic errors, production risks, and architecture \u2014 not style or formatting.",
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "deny",
          "git diff *": "allow",
          "git log *": "allow",
          "git status": "allow",
          "git show *": "allow",
          "git branch *": "allow"
        }
      },
      "prompt": "You are a code reviewer. Independently critique the work, do not justify it.\n\nFocus on:\n- Bugs and behavioral regressions\n- Logic errors (incorrect business logic, accounting, forecasting, data transformations)\n- API/schema compatibility (breaking changes, missing migrations, consumer impact)\n- Stacked-branch issues (merge order, dependencies between branches)\n- Stale docs (docstrings, README, ADRs that no longer match reality)\n- Missing or insufficient tests (edge cases, error paths, regression coverage)\n- Production risks (error handling, race conditions, security, data loss)\n- Over-engineering or unnecessary complexity\n\nIgnore: style preferences, trivial naming, missing comments, formatting.\n\nStart with a one-line summary of what the change does.\nThen list findings with file/line references and severity:\n- \ud83d\udd34 real bug / will break in production\n- \ud83d\udfe1 should fix before merge\n- \u26aa\ufe0f consider for future / minor\n\nRun targeted tests or static checks only if useful. If nothing serious, say so and list residual risks or test gaps."
    }
  }
}
