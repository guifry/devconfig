      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "x": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@xdevplatform/xurl",
        "mcp",
        "https://api.x.com/mcp",
        "--app",
        "x-mcp"
      ],
      "timeout": 300000
    },
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "Authorization": "Bearer 21st_sk_bd5c31ceceea45a644d59d37fcda3583b2f3f24a7f59f15183888b77c80baf8d"
      },
