# ~/.secrets — sourced by zsh on startup (not version controlled)
# Copy to ~/.secrets and fill in the values.

# GitHub personal access token.
# LEAVE COMMENTED unless you actually need it: an exported-but-empty GH_TOKEN still
# counts as "set" and takes precedence over gh's keyring auth in some gh versions.
# If you use `gh auth login`, you do not need this at all.
# Get from: gh auth switch -u guifry && gh auth token
# Work token goes in ~/kpler/.envrc, not here — see Readme for multi-account setup.
# export GH_TOKEN=""

# Claude Code OAuth token (from: claude auth)
# Used by codecompanion.nvim's claude_code ACP adapter
export CLAUDE_CODE_OAUTH_TOKEN=""

# DeepSeek API key (default adapter for codecompanion.nvim)
export DEEPSEEK_API_KEY=""

# Groq API key (prompt-reformat hotkey daemon)
export GROQ_API_KEY=""

# Kpler PackageCloud read token (from: Bitwarden → PACKAGECLOUD_READ_TOKEN)
export PACKAGECLOUD_READ_TOKEN=""
