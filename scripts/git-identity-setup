#!/usr/bin/env bash
# git-identity-setup — create the per-directory git identity files.
#
# home.nix references ~/.gitconfig-{kpler,gds,guifry,bp} but deliberately does not
# ship them: this repo is public and they contain email addresses. Without them
# user.useConfigOnly makes git refuse to commit, which is safe but blocks work.
#
# Emails are GitHub noreply addresses, derived automatically from the username via
# the public API — no token needed, and no real address ends up in commit history.
#
# Idempotent: never overwrites an existing file unless --force.

set -uo pipefail

FORCE=false
[[ "${1:-}" == "--force" ]] && FORCE=true

lookup_id() { # github login -> numeric id
  curl -fsSL "https://api.github.com/users/$1" 2>/dev/null \
    | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' | head -1
}

make_identity() { # target-file, label, hint
  local file="$HOME/$1" label="$2" hint="$3"

  if [ -f "$file" ] && [ "$FORCE" = false ]; then
    echo "  [skip] ~/$1 already exists ($(sed -n 's/^[[:space:]]*email = //p' "$file" | head -1))"
    return
  fi

  echo ""
  read -r -p "  $label GitHub username (blank to skip) [$hint]: " login < /dev/tty
  [ -z "$login" ] && { echo "  [skip] $label"; return; }

  local id
  id=$(lookup_id "$login")
  if [ -z "$id" ]; then
    echo "  ERROR: could not look up '$login' on github.com — skipped" >&2
    return
  fi

  read -r -p "  Display name for commits [$login]: " name < /dev/tty
  [ -z "$name" ] && name="$login"

  cat > "$file" <<EOF
# $label identity. GitHub noreply address: attributes commits to the $login account
# without exposing a real email. Generated by scripts/git-identity-setup.
[user]
	name = $name
	email = ${id}+${login}@users.noreply.github.com
EOF
  echo "  [ok] ~/$1  ->  ${id}+${login}@users.noreply.github.com"
}

echo "Git identity setup"
echo "=================="
echo "Creates the per-directory identity files that home.nix's includes point at."
echo "Emails are derived as <id>+<login>@users.noreply.github.com."

make_identity ".gitconfig-guifry" "Personal (~/projects)" "guifry"
make_identity ".gitconfig-kpler"  "Work (~/kpler)"        "gforey-ext"

echo ""
echo "Verify with: git-identity-test"
