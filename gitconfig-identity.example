# Per-directory git identity — NOT version controlled (holds email addresses).
#
# home.nix declares conditional includes in programs.git.includes:
#
#   gitdir:~/kpler/     -> ~/.gitconfig-kpler
#   gitdir:~/GDS/       -> ~/.gitconfig-gds
#   gitdir:~/projects/  -> ~/.gitconfig-guifry
#   gitdir:~/bp/        -> ~/.gitconfig-bp
#
# devconfig deliberately does not create these — this repo is public. Create the ones
# you need by hand, using the shape below.
#
# WITHOUT THEM user.email is unset and git silently derives an author from the
# hostname (e.g. guilhem@Guilhems-MacBook-Pro.local). Commits succeed but do not link
# to any GitHub account. `devconfig doctor` checks for this.
#
# ---------------------------------------------------------------------------
# USE GITHUB NOREPLY ADDRESSES, NOT REAL ONES
# ---------------------------------------------------------------------------
# Format: <numeric-id>+<login>@users.noreply.github.com
#
# Why:
#   - keeps a personal address out of a work org's commit history (and vice versa)
#   - attributes the commit to the right GitHub account, which a real address only
#     does if it is a *verified* address on that account
#
# Find the numeric id for an account:
#   gh api user --jq '.id'                      # for the currently active gh account
#   gh api users/<login> --jq '.id'             # for any account
# Or: GitHub → Settings → Emails → "Keep my email addresses private" shows it.
#
# ---------------------------------------------------------------------------
# Copy to ~/.gitconfig-<name> and edit:

[user]
	name = Your Name
	email = 0000000+yourlogin@users.noreply.github.com
